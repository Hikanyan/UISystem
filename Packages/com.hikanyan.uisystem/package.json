{
  "name": "com.hikanyan.uisystem",
  "version": "2.0.0-preview.1",
  "displayName": "Hikanyan UI System",
  "description": "A lightweight UI management system for Unity with MVP architecture support",
  "unity": "6000.3",
  "keywords": [
    "ui",
    "mvp",
    "hikanyan"
  ],
  "author": {
    "name": "Hikanyan",
