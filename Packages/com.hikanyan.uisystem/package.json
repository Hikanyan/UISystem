  "license": "MIT",
  "homepage": "https://github.com/Hikanyan/UISystem",
  "bugs": {
    "url": "https://github.com/Hikanyan/UISystem/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hikanyan/UISystem.git"
  },
  "dependencies": {
    "com.unity.addressables": "2.9.1",
    "com.cysharp.unitask": "2.5.10",
    "com.unity.ugui": "2.0.0"
  },
  "samples": [
    {
      "path": "Samples~/Minimal",
      "description": "Ready-to-play scene with typed arguments, game data, modal result and focus restoration. Requires Input System.",
      "displayName": "Minimal Inventory and Dialog"
    },
    {
      "path": "Samples~/Scene",
      "description": "Scene UI API code examples. Requires TextMeshPro and Input System.",
      "displayName": "Legacy Scene API"
    },
    {
      "path": "Samples~/Prefab",
      "description": "Addressables API code examples. Requires configured prefab addresses and TextMeshPro.",
      "displayName": "Legacy Prefab API"
    }
  ]
